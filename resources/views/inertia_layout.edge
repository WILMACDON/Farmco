<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#2F6B3F">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Farmco">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/farmco-icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/farmco-icon.svg">

  <title inertia>Farmco</title>

  {{-- Apply stored theme before paint so auth and other pages without ThemeToggle stay correct on reload --}}
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('theme')
        var theme = stored === 'light' || stored === 'dark'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        document.documentElement.classList.remove('light', 'dark')
        document.documentElement.classList.add(theme)
      } catch (e) {}
    })()
  </script>

  @stack('dumper')
  @viteReactRefresh()
  @inertiaHead()
  @vite(['resources/css/app.css', 'inertia/app/app.tsx'])
</head>

<body class="min-h-screen w-screen font-sans">
  @inertia()
</body>

</html>
